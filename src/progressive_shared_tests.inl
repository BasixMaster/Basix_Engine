std::vector<NativeInstance> shared_specs(const bi::Batch& batch,bool bad_slot=false){std::vector<NativeInstance> specs;for(size_t i=0;i<batch.matrices.size();++i)specs.push_back({batch.matrices[i],uint32_t(bad_slot&&i==1?batch.matrices.size():i)});return specs;}
ref::Scene shared_probe_mesh(){ref::Scene mesh;mesh.materials={{1,{.7,.1,.1},.5,0,{},br::MaterialModel::lambert},{2,{.1,.7,.1},.5,0,{},br::MaterialModel::lambert}};mesh.triangles={{7,1,{-.6,-.6,0},{.6,-.6,0},{.6,.6,0}},{11,1,{-.6,-.6,0},{.6,.6,0},{-.6,.6,0}}};for(auto& t:mesh.triangles){t.a=quantize(t.a);t.b=quantize(t.b);t.c=quantize(t.c);}return mesh;}
