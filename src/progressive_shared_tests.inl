 if(fault=="span"){metadata[1].first_triangle=uint32_t(batch.shader_scene.triangles.size());metadata[1].triangle_count=2;}
 if(fault=="orientation")for(size_t i=0;i<signs.size();++i)if(signs[i]<0)signs[i]=1;
 std::vector<basix::transform_uncertainty::Budget> budgets;if(transform_rays){require(mesh!=nullptr,"Transform bounds need object mesh");budgets=basix::transform_uncertainty::analyze(*mesh,batch);}
