std::vector<bi::InputInstance> shared_inputs(unsigned phase,bool render){
 bi::InputInstance a,b;a.stable_id=10000123;b.stable_id=90000007;a.primitive_id_base=1000;b.primitive_id_base=2000;a.material_override=render?0:1;b.material_override=render?0:2;
 a.matrix={1,0,0,-1.3f,0,1,0,0,0,0,1,0};b.matrix={-1,.25f,0,1.3f,0,1,0,0,.25f,0,1,0};
 if(phase==1){a.matrix[3]=-1.15f;a.matrix[7]=.15f;a.matrix[11]=.1f;b.matrix[0]=-1.25f;b.matrix[5]=.75f;b.matrix[3]=1.2f;b.matrix[7]=-.1f;b.matrix[11]=-.15f;}
 // Keep rendered rooms disjoint: phase1 formerly placed both floors on y=-.85
 // with overlapping x spans, making primitive selection genuinely ambiguous.
 if(render){a.matrix[3]-=.7f;b.matrix[3]+=.7f;}
