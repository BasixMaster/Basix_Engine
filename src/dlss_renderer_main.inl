br::Vec3 inverse_point(const bi::Matrix& m,br::Vec3 p){
 const double a=m[0],b=m[1],c=m[2],d=m[4],e=m[5],f=m[6],g=m[8],h=m[9],i=m[10],det=a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g);require(std::isfinite(det)&&det!=0,"Invalid previous-object inverse");p=p-br::Vec3{m[3],m[7],m[11]};return {((e*i-f*h)*p.x+(c*h-b*i)*p.y+(b*f-c*e)*p.z)/det,((f*g-d*i)*p.x+(a*i-c*g)*p.y+(c*d-a*f)*p.z)/det,((d*h-e*g)*p.x+(b*g-a*h)*p.y+(a*e-b*d)*p.z)/det};
}
